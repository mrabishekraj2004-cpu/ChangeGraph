AUTH_SECRET=replace-with-a-long-random-secret
APP_URL=http://localhost:3000
EMAIL_PROVIDER=none
EMAIL_FROM=ChangeGraph <noreply@example.com>
RESEND_API_KEY=
CHANGEGRAPH_DB_PATH=./data/changegraph.db
# PostgreSQL is an opt-in migration validation target. The live app remains on
# SQLite until all domain repositories are migrated; do not set DATABASE_URL
# for the single-host demo.
DATABASE_URL=
CHANGEGRAPH_POSTGRES_DB=changegraph
CHANGEGRAPH_POSTGRES_USER=changegraph
CHANGEGRAPH_POSTGRES_PASSWORD=
CHANGEGRAPH_POSTGRES_PORT=55432
# Set to the exact number of trusted reverse proxies in front of the app.
# Keep at 0 when forwarding headers are not set by a trusted proxy.
CHANGEGRAPH_TRUSTED_PROXY_HOPS=0
CHANGEGRAPH_INGEST_TOKEN=replace-with-a-workspace-ingest-token
CHANGEGRAPH_INGEST_WORKSPACE_ID=replace-with-the-target-workspace-id
GITHUB_WEBHOOK_SECRET=replace-with-a-github-webhook-secret
GITHUB_WORKSPACE_ID=replace-with-the-target-workspace-id
# Optional: allow the local demo seed to be created when NODE_ENV=production.
CHANGEGRAPH_SEED_DEMO=false
# Optional: tune the event worker's retry ceiling (default is 3).
CHANGEGRAPH_MAX_EVENT_ATTEMPTS=3
# Optional local worker tuning.
CHANGEGRAPH_EVENT_LEASE_SECONDS=300
CHANGEGRAPH_WORKER_INTERVAL_MS=5000
CHANGEGRAPH_WORKER_BATCH_SIZE=25
CHANGEGRAPH_WORKER_STALE_MS=30000
# Optional dedicated token for the protected operational metrics endpoint.
CHANGEGRAPH_METRICS_TOKEN=
# Optional future model gateway. The local baseline investigator remains available without it.
AI_GATEWAY_API_KEY=
AI_MODEL=
